{
  "name": "todo",
  "version": "1.0.0",
  "keywords": [],
  "license": "ISC",
  "author": "oktntko@gmail.com",
  "type": "module",
  "scripts": {
    "dev": "turbo dev --ui=tui || true",
    "dev:msw": "pnpm --filter='@todo/vue' dev:msw",
    "build": "turbo build",
    "build:msw": "turbo build:msw",
    "type-check": "turbo type-check",
    "preview": "turbo preview --ui=tui || true",
    "generate": "pnpm --filter='@todo/prisma' 'prisma:generate'",
    "migrate": "pnpm --filter='@todo/prisma' 'prisma:migrate:dev'",
    "seed": "pnpm --filter='@todo/prisma' 'prisma:seed'",
    "lint": "turbo lint",
    "spell-check": "cspell .",
    "format": "turbo format",
    "test": "turbo test"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.0.1",
    "@tsconfig/node26": "^26.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cspell": "^10.0.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsdown": "^0.22.12",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.15.1"
}
