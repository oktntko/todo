{
  "name": "@todo/hono-react",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:client": "vite",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/index.ts",
    "build": "run-p build:*",
    "build:client": "vite build",
    "build:server": "tsdown",
    "type-check": "run-p type-check:*",
    "type-check:client": "tsc --project tsconfig.client.json",
    "type-check:server": "tsc --project tsconfig.server.json && tsc-alias --project tsconfig.server.json",
    "preview": "node dist/index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/m-plus-1-code": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-router": "^1.170.36",
    "@todo/lib": "workspace:*",
    "@todo/prisma": "workspace:*",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "clsx": "^2.1.1",
    "hono": "^4.13.7",
    "jotai": "^3.0.0",
    "motion": "^13.2.0",
    "openai": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@iconify/json": "^2.2.527",
    "@iconify/tailwind4": "^1.2.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-plugin": "^1.168.38",
    "@types/babel__core": "^7.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/speakeasy": "^2.0.10",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
