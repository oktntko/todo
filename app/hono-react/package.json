{
  "name": "@todo/hono-react",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:client": "vite",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/index.ts",
    "build": "run-p build:*",
    "build:client": "vite build",
    "build:server": "tsdown",
    "type-check": "run-p type-check:*",
    "type-check:client": "tsc --project tsconfig.client.json",
    "type-check:server": "tsc --project tsconfig.server.json && tsc-alias --project tsconfig.server.json",
    "preview": "node dist/index.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@todo/lib": "workspace:*",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0"
  }
}
