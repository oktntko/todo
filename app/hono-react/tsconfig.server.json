{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@tsconfig/node26/tsconfig.json", "@tsconfig/strictest/tsconfig.json"],
  "references": [
    {
      "path": "../../common/lib/tsconfig.base.json"
    },
    {
      "path": "../../common/prisma/tsconfig.base.json"
    }
  ],
  "include": ["src/server", "src/@types/index.d.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    // override strictest
    "exactOptionalPropertyTypes": false,
    // app settings
    "paths": {
      "@/*": ["./src/server/*"]
    },
    "noUnusedLocals": false,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": "./src/server",
    "outDir": "./dist"
  }
}
