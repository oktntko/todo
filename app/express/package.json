{
  "name": "@todo/express",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "dev": "run-p dev:*",
    "dev:serve": "tsx watch --tsconfig tsconfig.base.json src/index.ts | pino-pretty",
    "dev:barrel": "tsx watch --include='src/schema' --exclude='src/schema/index.ts' ../../script/generateBarrelFile.ts src/schema",
    "build": "tsdown",
    "type-check": "rm -rf types && tsc --project tsconfig.base.json && tsc-alias --project tsconfig.base.json",
    "preview": "node --enable-source-maps dist/index.mjs",
    "lint": "oxlint --type-aware --type-check",
    "format": "oxfmt",
    "test": "vitest run",
    "test:preview": "vitest --ui"
  },
  "dependencies": {
    "@todo/lib": "workspace:*",
    "@todo/prisma": "workspace:*",
    "@trpc/server": "11.18.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.9",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "2.2.0",
    "openai": "^6.48.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.2",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@types/speakeasy": "^2.0.10",
    "pino-pretty": "^13.1.3"
  },
  "packageManager": "pnpm@11.15.1"
}
