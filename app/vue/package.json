{
  "name": "@todo/vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:msw": "MODE='msw' run-s drizzle:generate && vite --mode msw",
    "build": "vite build",
    "build:msw": "MODE='msw' vite build --mode msw",
    "type-check": "vue-tsc --build --force tsconfig.app.json",
    "preview": "vite preview",
    "lint": "oxlint --type-aware --type-check",
    "format": "oxfmt",
    "test:unit": "vitest run",
    "test:preview": "vitest --ui",
    "test:e2e": "playwright test",
    "drizzle:generate": "drizzle-kit generate && tsx ./drizzle.generate-migrations.ts && oxfmt --write src/mock/migrations.json"
  },
  "dependencies": {
    "@daypilot/daypilot-lite-javascript": "^5.10.0",
    "@fontsource-variable/m-plus-1-code": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@todo/express": "workspace:*",
    "@todo/lib": "workspace:*",
    "@todo/prisma": "workspace:*",
    "@trpc/client": "11.18.0",
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "fabric": "^7.4.0",
    "pinia": "^4.0.2",
    "sortablejs": "^1.15.7",
    "superjson": "^2.2.6",
    "use-vue-validate-schema": "^1.0.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@iconify/json": "^2.2.503",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@trpc/server": "11.18.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/runtime-core": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "msw-trpc": "^2.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue-component-type-helpers": "^3.3.7",
    "vue-tsc": "^3.3.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
